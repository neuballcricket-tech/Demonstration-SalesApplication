  "crossFieldRules": [
    "count(containers where included) = noOfContainersOnBl",
    "sum(containers.packages) = totalPackages",
    "sum(containers.grossWeight) = grossWeight",
    "sum(containers.cbm) = cbm",
    "netWeight <= grossWeight",
    "blTerm = NEGOTIABLE implies noOfOriginalBls >= 1",
    "surrendered = true implies noOfOriginalBls = 0",
    "dateOfBlIssued >= shippedOnBoardDate",
    "podEta > shippedOnBoardDate",
    "abs(podEta - shippedOnBoardDate) ~= transitTime",
    "receivedForShipment = NO implies shippedOnBoardDate is present",
    "polCode != podCode",
    "freightTerm = COLLECT implies freightPayableAt is present",
    "charge line: prepaidRate and collectRate are mutually exclusive",
    "charge currency != base implies exchangeRate > 0",
    "draftConfirmed = true implies zero errors"
  ],
  "knownGaps": [
    "No VGM value, weighing method or authorised party — mandatory under SOLAS VI/2 before loading.",
    "No dangerous goods block (UN number, IMO class, packing group, flashpoint, EmS, 24h emergency contact).",
    "No reefer block (set temperature, ventilation, humidity).",
    "No out-of-gauge dimensions.",
    "No shipper or consignee tax identifier (EORI, VAT, TIN) — required for EU and UK entry.",
    "No declared value / ad valorem field.",
    "HS code is a single header field; multi-commodity shipments need it per cargo line."
  ]
}