    {
      "id": "clauses",
      "title": "Special clauses (printed on face)",
      "hint": "These are the carrier's standard printed notices. They appear verbatim on the bill — record exactly what MSC uses so the generated document is faithful.",
      "fields": [
        {
          "k": "thermalClause",
          "l": "Thermal / seasonal clause",
          "t": "textarea",
          "dt": "TEXT",
          "lines": 5,
          "linelen": 80,
          "w": 12,
          "v": "Carrier has no liability or responsibility whatsoever for thermal loss or damage to the goods by reason of natural variations in atmospheric temperatures during the winter period, and / or caused by inadequate packing of the Goods for carriage in dry-van containers, and / or inherent vice of the Goods, in such temperatures."
        },
        {
          "k": "palletsClause",
          "l": "Pallets / equipment clause",
          "t": "textarea",
          "dt": "TEXT",
          "lines": 4,
          "linelen": 80,
          "w": 12,
          "v": "Containers, pallets or similar articles of transport supplied by or on behalf of the carrier shall be returned to the carrier in the same order and condition as handed over to the shipper or consignee..."
        },
        {
          "k": "riderNote",
          "l": "Rider reference note",
          "t": "text",
          "dt": "VARCHAR(120)",
          "v": "Please see attached RIDER for Container / Cargo Description(s).",
          "w": 8
        }
      ]
    }
  ],
  "crossFieldRules": [
    "sum(containers.grossWeight) = totalGrossWeight",
    "totalNetWeight <= totalGrossWeight",
    "count(active containers) = carrierReceipt integer",
    "shippedOnBoardDate >= dateOfIssue",
    "transportType = PORT-TO-PORT implies placeOfReceipt = blank",
    "transportType = COMBINED TRANSPORT implies placeOfReceipt is present",
    "portOfLoading != portOfDischarge",
    "shipper on Master BL must be the forwarder, not the cargo owner"
  ],
  "keyDifferencesFromHouseBL": [
    "Shipper = freight forwarder (not cargo owner)",
    "Consignee = destination agent (not buyer)",
    "Document type = Sea Waybill (non-negotiable) — no originals issued",
    "Release at POD requires proof of identity only, no surrender of document",
    "Freight shown as 'AS PER AGREEMENT' — no line-item charges on face",
    "Carrier's receipt counts containers, not packages",
    "No B/L term, no number-of-originals, no notify disclaimer fields — those live on the House BL"
  ]
}