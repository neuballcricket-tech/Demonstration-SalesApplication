{
  "document": "Master Bill of Lading — MSC Sea Waybill",
  "reference": "MEDUKL812774",
  "note": "On a Master B/L the Shipper is the freight forwarder (CLS), the Consignee is the destination agent (PFE Express). The actual cargo owner only appears on the House B/L.",
  "sections": [
    {
      "id": "docheader",
      "title": "Document header",
      "hint": "Carrier-issued identifiers. The waybill number is assigned by MSC — CLS records it here as a reference.",
      "fields": [
        {
          "k": "waybillNo",
          "l": "Sea Waybill no.",
          "t": "code",
          "dt": "VARCHAR(20)",
          "req": 1,
          "v": "MEDUKL812774",
          "pat": "^[A-Z]{3}[A-Z]{2}\\d{6}$",
          "patMsg": "Format: 3-letter carrier code + 2-letter country + 6 digits.",
          "w": 3,
          "note": "Carrier-generated. Unique globally. Do not alter."
        },
        {
          "k": "waybillSeq",
          "l": "No. & sequence of waybills",
          "t": "num",
          "dt": "TINYINT",
          "req": 1,
          "v": "1",
          "min": 1,
          "max": 9,
          "int": 1,
          "w": 2
        },
        {
          "k": "riderPages",
          "l": "No. of rider pages",
          "t": "num",
          "dt": "TINYINT",
          "req": 1,
          "v": "1",
          "min": 0,
          "max": 20,
          "int": 1,
          "w": 2
        },
        {
          "k": "transportType",
          "l": "Transport type",
          "t": "select",
          "dt": "ENUM",
          "req": 1,
          "opts": [
            "PORT-TO-PORT",
            "COMBINED TRANSPORT"
          ],
          "v": "PORT-TO-PORT",
          "w": 3,
          "note": "Combined Transport activates Place of Receipt and Place of Delivery fields."
        },
        {
          "k": "lloydsImo",
          "l": "Lloyds / IMO number",
          "t": "code",
          "dt": "VARCHAR(10)",
          "v": "9484479",
          "pat": "^\\d{7}$",
          "patMsg": "7-digit IMO vessel identifier.",
          "w": 2
        }
      ]
    },
    {
      "id": "carrier",
      "title": "Carrier",
      "hint": "Printed top-left on every MSC document. These are static for MSC but other carriers differ.",
